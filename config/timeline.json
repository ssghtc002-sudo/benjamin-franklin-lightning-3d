  "dialogue": [
    {
      "id": "L1",
      "beatId": "B1",
      "speaker": "narrator",
      "start": 0.12,
      "end": 4.38,
      "text": "In 1752, one wild man flew a kite into a storm—to catch lightning on a key!"
    },
    {
      "id": "L2",
      "beatId": "B2",
      "speaker": "william",
      "start": 4.50,
      "end": 6.85,
      "text": "Father, stop—that lightning bolt could kill us!"
    },
    {
      "id": "L3",
      "beatId": "B2",
      "speaker": "franklin",
      "start": 6.95,
      "end": 9.70,
      "text": "Touch the brass key, William—lightning is pure electricity!"
    },
    {
      "id": "L4",
      "beatId": "B3",
      "speaker": "narrator",
      "start": 9.82,
      "end": 15.35,
      "text": "He bottled real storm lightning in a glass Leyden jar—naming positive and negative charge!"
    },
    {
      "id": "L5",
      "beatId": "B4",
      "speaker": "narrator",
      "start": 15.50,
      "end": 18.00,
      "text": "Then Franklin built the copper lightning rod—"
    },
    {
      "id": "L6",
      "beatId": "B4",
      "speaker": "william",
      "start": 17.72,
      "end": 20.45,
      "text": "Whoa! It steered a thunderbolt straight into the earth!"
    },
    {
      "id": "L7",
      "beatId": "B5",
      "speaker": "narrator",
      "start": 20.55,
      "end": 25.35,
      "text": "One fearless storm test saved millions of homes, and sparked the entire electric age!"
    },
    {
      "id": "L8",
      "beatId": "B6",
      "speaker": "narrator",
      "start": 25.50,
      "end": 29.80,
      "text": "Skyscrapers, batteries, your phone right now—all trace back to Benjamin Franklin!"
    }
  ],
